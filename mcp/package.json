{
  "name": "labmentor-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that lets an instructor's AI client read LabMentor labs and insights.",
  "type": "module",
  "bin": { "labmentor-mcp": "dist/index.js" },
  "engines": { "node": ">=24" },
