# Copy to .env.local for `npm run dev`. Every value here is for local development only.

# The web app connects as the restricted application role. Row-level security applies to it.
DATABASE_URL=postgres://labmentor_app:dev-app-password@localhost:5432/labmentor
# Migrations and seeding connect as the owner of the tables.
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/labmentor
APP_DB_PASSWORD=dev-app-password

# At least 32 characters. Signs session cookies and API tokens.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# The Python assistant service and the key it expects.
ASSISTANT_URL=http://localhost:8000
ASSISTANT_SERVICE_KEY=dev-service-key

# Shows the demo people on the sign-in page. Never set this in production.
DEMO_SIGN_IN=true
